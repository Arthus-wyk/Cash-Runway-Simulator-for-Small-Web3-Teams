# Server only. CMC_API (existing local name) is also supported.
CMC_API_KEY=replace_with_your_key

# Set these in Vercel Environment Variables (or the process environment).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SNAPSHOT_SECRET=replace_with_a_random_secret_at_least_32_characters
# Optional custom domains, hostnames only; exact Vercel deployment URLs are automatic.
ALLOWED_HOSTS=runway.example.com
# Optional filesystem paths for other ASGI hosts; Vercel uses temporary quote storage.
# CACHE_DIR=/var/cache/runway
# HISTORY_DIR=/app/evidence/history
